{
  "id": "academic",
  "name": "学术汇报",
  "version": 1,
  "fonts": { "version": "1", "stack": ["Inter", "Source Sans 3", "Noto Sans SC", "PingFang SC", "Microsoft YaHei", "sans-serif"] },
  "tokens": {
    "color": {
      "bg": "#FBFAF7",
      "surface": "#FFFFFF",
      "text": "#1B1B1F",
      "muted": "#5B5B66",
      "primary": "#7A1F1F",
      "accent": "#1F4E79",
      "border": "#D9D5CC",
      "onPrimary": "#FFFFFF"
    },
    "font": {
      "display": "Source Serif 4, Noto Serif SC, Georgia, serif",
      "body": "Inter, Source Sans 3, Noto Sans SC, PingFang SC, Microsoft YaHei, sans-serif",
      "mono": "JetBrains Mono, SFMono-Regular, Consolas, monospace"
    },
    "space": { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "24px" },
    "radius": { "sm": "4px", "md": "8px", "lg": "12px" },
    "shadow": { "sm": "0 1px 2px rgba(27,27,31,0.08)", "md": "0 8px 24px rgba(27,27,31,0.10)" },
    "cssVariables": {
      "--color-bg": "#FBFAF7",
      "--color-surface": "#FFFFFF",
      "--color-text": "#1B1B1F",
      "--color-muted": "#5B5B66",
      "--color-primary": "#7A1F1F",
      "--color-accent": "#1F4E79",
      "--color-border": "#D9D5CC",
      "--color-on-primary": "#FFFFFF",
      "--font-display": "Source Serif 4, Noto Serif SC, Georgia, serif",
      "--font-body": "Inter, Source Sans 3, Noto Sans SC, PingFang SC, Microsoft YaHei, sans-serif",
      "--font-mono": "JetBrains Mono, SFMono-Regular, Consolas, monospace",
      "--size-1": "16px",
      "--size-2": "20px",
      "--size-3": "28px",
      "--size-4": "40px",
      "--size-5": "64px",
      "--radius-sm": "4px",
      "--radius-md": "8px",
      "--radius-lg": "12px",
      "--shadow-sm": "0 1px 2px rgba(27,27,31,0.08)",
      "--shadow-md": "0 8px 24px rgba(27,27,31,0.10)"
    }
  },
  "layouts": ["cover", "toc", "bullets", "split-lr", "split-tb", "cards-3", "chart", "big-number", "quote", "compare", "timeline", "process", "full-image", "ending"],
  "motionCapabilities": ["fade", "push", "wipe", "slide", "zoom"],
  "typography": { "scale": 1.0, "lineHeightBody": 1.65, "lineHeightCJK": 1.75, "lineHeightHeading": 1.25 }
