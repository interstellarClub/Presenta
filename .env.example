# ---------- core ----------
APP_ENV=dev
SECRET_KEY=dev-insecure-secret-change-me
INVITE_HMAC_SALT=dev-invite-salt
SESSION_TTL_HOURS=168

# ---------- database / queue ----------
# dev fallback (no infra needed):
DATABASE_URL=sqlite+aiosqlite:///./dev.db
QUEUE_BACKEND=local
REDIS_URL=redis://localhost:6379/0

# docker compose:
# DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app
# QUEUE_BACKEND=arq

# ---------- storage ----------
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./.storage
# docker compose:
# STORAGE_BACKEND=s3
# S3_ENDPOINT=http://localhost:9000
S3_BUCKET=presenta
S3_KEY=minioadmin
S3_SECRET=minioadmin
S3_REGION=us-east-1

# ---------- model (REAL API REQUIRED FOR ACCEPTANCE) ----------
# 本版验收必须使用真实 DeepSeek：LLM_PROVIDER 默认 deepseek，且 Key 必填。
# 缺少 Key 时应用会在启动阶段直接失败，不再静默降级为 mock。
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=请填入真实 Key（不要提交到仓库）
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_THINKING=true
LLM_MAX_TOKENS=8192
LLM_MAX_RETRIES=2
LLM_TIMEOUT_S=120
BATCH_CONCURRENCY_PER_USER=3
# 外部来源 provenance 默认关闭；确需启用时显式打开并保留审计。
ALLOW_EXTERNAL_PROVENANCE=false

# ---------- render / export ----------
RENDER_SVC_URL=http://localhost:8100
RENDER_SVC_TOKEN=dev-render-token
PANDOC_PATH=pandoc

# ---------- limits / retention ----------
MAX_UPLOAD_MB=50
MAX_DECK_PAGES=500
INGEST_TIMEOUT_S=120
MAX_DOCX_UNCOMPRESSED_MB=200
MAX_DOCX_COMPRESSION_RATIO=100
PURGE_RETENTION_DAYS=7
SHARE_DEFAULT_TTL_HOURS=72
SHARE_SESSION_TTL_S=7200
SHARE_TOKEN_KEEP_EXPIRED_DAYS=7
DOWNLOAD_URL_TTL_S=300
RATE_LIMIT_REGISTER_PER_HOUR=5
RATE_LIMIT_LOGIN_PER_HOUR=30

# ---------- web ----------
WEB_ORIGIN=http://localhost:5173