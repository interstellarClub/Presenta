{
  "id": "minimal",
  "name": "极简黑白",
  "version": 1,
  "fonts": { "version": "1", "stack": ["Inter", "Source Sans 3", "Noto Sans SC", "PingFang SC", "Microsoft YaHei", "sans-serif"] },
  "tokens": {
    "color": {
      "bg": "#FFFFFF",
      "surface": "#F7F7F7",
      "text": "#111111",
      "muted": "#636363",
      "primary": "#111111",
      "accent": "#4A4A4A",
      "border": "#E5E5E5",
      "onPrimary": "#FFFFFF"
    },
    "font": {
      "display": "Inter, Noto Sans SC, PingFang SC, sans-serif",
      "body": "Inter, Source Sans 3, Noto Sans SC, PingFang SC, Microsoft YaHei, sans-serif",
      "mono": "JetBrains Mono, SFMono-Regular, Consolas, monospace"
    },
    "space": { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "24px" },
    "radius": { "sm": "0px", "md": "0px", "lg": "0px" },
    "shadow": { "sm": "none", "md": "none" },
    "cssVariables": {
      "--color-bg": "#FFFFFF",
      "--color-surface": "#F7F7F7",
      "--color-text": "#111111",
      "--color-muted": "#636363",
      "--color-primary": "#111111",
      "--color-accent": "#4A4A4A",
      "--color-border": "#E5E5E5",
      "--color-on-primary": "#FFFFFF",
      "--font-display": "Inter, Noto Sans SC, PingFang SC, sans-serif",
      "--font-body": "Inter, Source Sans 3, Noto Sans SC, PingFang SC, Microsoft YaHei, sans-serif",
      "--font-mono": "JetBrains Mono, SFMono-Regular, Consolas, monospace",
      "--size-1": "16px",
      "--size-2": "21px",
      "--size-3": "30px",
      "--size-4": "44px",
      "--size-5": "72px",
      "--radius-sm": "0px",
      "--radius-md": "0px",
      "--radius-lg": "0px",
      "--shadow-sm": "none",
      "--shadow-md": "none"
    }
  },
  "layouts": ["cover", "toc", "bullets", "split-lr", "split-tb", "cards-3", "chart", "big-number", "quote", "compare", "timeline", "process", "full-image", "ending"],
  "motionCapabilities": ["fade"],
  "typography": { "scale": 1.0, "lineHeightBody": 1.65, "lineHeightCJK": 1.75, "lineHeightHeading": 1.25 }
}